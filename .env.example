IKUNANCE_DEPLOY_HOST=
IKUNANCE_DEPLOY_USER=
IKUNANCE_DEPLOY_PASSWORD=
IKUNANCE_DEPLOY_SSH_PORT=22
# Must be an absolute remote path.
IKUNANCE_DEPLOY_REMOTE=/www/wwwroot/ikunance
IKUNANCE_DEPLOY_PORT=5000
IKUNANCE_DEPLOY_WORKERS=1
IKUNANCE_DEPLOY_THREADS=6
IKUNANCE_DEPLOY_LOG_RETENTION_DAYS=7
# Must be an absolute remote path and should not be overwritten by code deploys.
IKUNANCE_DEPLOY_DATA_DIR=/www/wwwroot/ikunance/backend/data
IKUNANCE_DEPLOY_HEALTH_URL=
IKUNANCE_DEPLOY_HEALTH_TIMEOUT=20

# Set to 1 to print upload plan without connecting to the server.
IKUNANCE_DEPLOY_DRY_RUN=1

# Backend runtime
IKUNANCE_HOST=0.0.0.0
IKUNANCE_PORT=5000
IKUNANCE_DATA_DIR=
IKUNANCE_FRONTEND_DIST=
IKUNANCE_APP_VERSION=local
IKUNANCE_LIVE_MARKET=0
IKUNANCE_BINANCE_PROVIDER=official
IKUNANCE_SYMBOL_SYNC_NETWORK=1
IKUNANCE_MARKET_PROXY=
IKUNANCE_PROXY=
IKUNANCE_ALLOW_BINANCE_SPOT_KLINE_FALLBACK=1
IKUNANCE_ALLOW_SYNTHETIC_MARKET_FALLBACK=0
IKUNANCE_DISABLE_OUTBOUND=1
IKUNANCE_CORS_ORIGINS=*
IKUNANCE_FORCE_HTTPS=0
IKUNANCE_MAX_UPLOAD_MB=8
IKUNANCE_AUTH_RATE_LIMIT=20
IKUNANCE_AUTH_RATE_WINDOW=60
IKUNANCE_ADMIN_ID=111
IKUNANCE_ADMIN_PASSWORD=
IKUNANCE_ACCESS_LOG=1
IKUNANCE_SINGLE_INSTANCE_LOCK=1
IKUNANCE_SCAN_WORKERS=4
IKUNANCE_SCAN_CONCURRENCY=1
IKUNANCE_SCAN_WAIT_SECONDS=2
IKUNANCE_SCAN_RATE_LIMIT=12
IKUNANCE_SCAN_RATE_WINDOW=60
IKUNANCE_LIVE_FETCH_MIN_INTERVAL=0.35
IKUNANCE_LIVE_FETCH_BACKOFF_BASE=5
IKUNANCE_LIVE_FETCH_BACKOFF_MAX=60
IKUNANCE_PUSH_MONITOR=1
IKUNANCE_PUSH_MONITOR_INTERVAL=900
IKUNANCE_PUSH_MONITOR_SYMBOL_PAUSE=0.5
IKUNANCE_SSE_QUEUE_SIZE=200
DOUBAO_API_KEY=
